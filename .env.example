# Le bot fonctionne SANS aucune cle. Ce fichier .env est OPTIONNEL.
# Copie-le en .env et renseigne ce dont tu as besoin.

# --- Export vers Notion (base d'equipe "SUIVI ALTERNANCE") -------------------------
# 1) https://www.notion.so/profile/integrations  ->  "New integration" (interne)
#    Copie le "Internal Integration Secret" (commence par ntn_ ou secret_)
# 2) Ouvre la base "SUIVI ALTERNANCE" -> menu ... -> "Connexions" -> ajoute ton integration
# 3) Colle le secret ici. L'ID de la base est deja dans config.json (notionDbId).
# NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_DB_ID=3d16931b4a3180caa3e6e746be1bf446

# --- Notifications Telegram (optionnel) -------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
